{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LevelDefinition V2",
  "description": "Топология уровня, доступный каталог, deterministic interior recipe и player-owned surface defaults",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "roomId",
    "name",
    "clientBriefId",
    "presentationProfileId",
    "roomDimensions",
    "availableItems",
    "interiorRecipeId",
    "generationSeed",
    "surfaceDefaults"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": { "type": "string" },
    "roomId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "clientBriefId": {
      "type": "string",
      "pattern": "^brief-[a-z0-9-]+$",
      "description": "Обязательная ссылка на client-owned deterministic evaluation policy"
    },
    "presentationProfileId": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "roomDimensions": {
      "type": "object",
      "required": ["width", "height", "depth"],
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "depth": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    },
    "availableItems": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 5,
      "uniqueItems": true
    },
    "interiorRecipeId": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "generationSeed": {
      "type": "integer",
      "minimum": 0
    },
    "surfaceDefaults": {
      "type": "object",
      "required": ["floorFinishId", "wallFinishId"],
      "properties": {
        "floorFinishId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "wallFinishId": { "type": "string", "pattern": "^[a-z0-9-]+$" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
