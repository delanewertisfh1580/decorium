{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "interior-recipe.v1.json",
  "title": "Decorium Interior Recipe Catalog V1",
  "type": "object",
  "required": ["schemaVersion", "recipes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "recipes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "placements"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "label": { "type": "string", "minLength": 1 },
          "placements": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["slotId", "itemId", "position", "rotation"],
              "properties": {
                "slotId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
                "itemId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
                "variantId": { "type": ["string", "null"], "pattern": "^[a-z0-9-]+$" },
                "position": {
                  "type": "object",
                  "required": ["x", "y", "z"],
                  "properties": {
                    "x": { "type": "number" },
                    "y": { "type": "number" },
                    "z": { "type": "number" }
                  },
                  "additionalProperties": false
                },
                "rotation": {
                  "type": "object",
                  "required": ["y"],
                  "properties": { "y": { "type": "number", "multipleOf": 90 } },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
