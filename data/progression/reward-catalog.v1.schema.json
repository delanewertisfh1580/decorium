{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "reward-catalog.v1.json",
  "title": "Decorium Progression Reward Catalog V1",
  "type": "object",
  "required": ["schemaVersion", "rewards"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "rewards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "levelId", "minimumStars", "grantUnlockIds"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "levelId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "minimumStars": { "type": "integer", "minimum": 1, "maximum": 5 },
          "grantUnlockIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
