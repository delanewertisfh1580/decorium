{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PresentationEnvironmentProfileCatalog",
  "type": "object",
  "required": ["schemaVersion", "profiles"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "schemaVersion",
          "id",
          "label",
          "room",
          "lightingPreset",
          "exteriorPreset",
          "ambientFixtures",
          "sceneLifePreset",
          "presentation"
        ],
        "properties": {
          "schemaVersion": { "const": 1 },
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "label": { "type": "string", "minLength": 1 },
          "room": {
            "type": "object",
            "required": ["floorPreset", "wallPreset", "openingsPreset", "cameraPreset"],
            "properties": {
              "floorPreset": { "enum": ["light-oak", "dark-oak", "concrete-sand"] },
              "wallPreset": { "enum": ["warm-plaster", "charcoal-accent", "gallery-white"] },
              "openingsPreset": { "enum": ["living-window-and-door", "media-narrow-window", "studio-wide-window"] },
              "cameraPreset": { "enum": ["compact-living", "intimate-media", "open-studio"] }
            },
            "additionalProperties": false
          },
          "lightingPreset": { "enum": ["warm-evening", "media-dusk", "bright-daylight"] },
          "exteriorPreset": { "enum": ["quiet-residential-street", "urban-evening", "courtyard-daylight"] },
          "ambientFixtures": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": ["mirror", "bookshelf", "resting-cat", "accent-wall-art", "low-bookshelf", "studio-planter", "gallery-shelf"]
            }
          },
          "sceneLifePreset": { "enum": ["calm-indoor-evening", "quiet-media-dusk", "studio-daylight"] },
          "presentation": {
            "type": "object",
            "required": ["title", "subtitle"],
            "properties": {
              "title": { "type": "string", "minLength": 1 },
              "subtitle": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
