{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Presentation Environment Profile Catalog V3",
  "description": "Structural room shell, exterior and atmosphere; player-owned interior is excluded",
  "type": "object",
  "required": ["schemaVersion", "profiles"],
  "properties": {
    "schemaVersion": { "const": 3 },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["schemaVersion", "id", "label", "room", "lightingPreset", "exteriorPreset", "sceneLifePreset", "presentation"],
        "properties": {
          "schemaVersion": { "const": 3 },
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "label": { "type": "string", "minLength": 1 },
          "room": {
            "type": "object",
            "required": ["openingsPreset", "cameraPreset", "exteriorCompositionPreset"],
            "properties": {
              "openingsPreset": { "enum": ["living-window-and-door", "media-narrow-window", "studio-wide-window"] },
              "cameraPreset": { "enum": ["compact-living", "intimate-media", "open-studio"] },
              "exteriorCompositionPreset": { "enum": ["residential-porch", "urban-cinema-block", "courtyard-workshop"] }
            },
            "additionalProperties": false
          },
          "lightingPreset": { "enum": ["warm-evening", "media-dusk", "bright-daylight"] },
          "exteriorPreset": { "enum": ["quiet-residential-street", "urban-evening", "courtyard-daylight"] },
          "sceneLifePreset": { "enum": ["calm-indoor-evening", "quiet-media-dusk", "studio-daylight"] },
          "presentation": {
            "type": "object",
            "required": ["title", "subtitle"],
            "properties": {
              "title": { "type": "string", "minLength": 1 },
              "subtitle": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
